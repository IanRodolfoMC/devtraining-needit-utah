        <name>Solicitud de compra - Validar precio</name>
        <order/>
        <script><![CDATA[function onSubmit() {
   var regex = /^\d+(\.\d{1,2})?$/;

   var precio = g_form.getValue('precio_unitario_estimado');
   precio = precio.replace(/,/g, '');

   if((!regex.test(precio) || precio == '0.00') || (precio == '0.0' || precio == '0')){

	g_form.showFieldMsg('precio_unitario_estimado', 'Por favor ingrese un Precio Unitario Estimado valido');

	return false;
   }

   return true;

}]]></script>
