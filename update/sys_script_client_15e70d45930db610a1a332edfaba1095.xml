        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
   if (isLoading || newValue === '') {
      return;
   }

   var precio = g_form.getValue('precio_unitario_estimado');
   precio = parseFloat(precio.replace(/,/g, ''));
   var cantidad = parseFloat(newValue);
   var resultado=0.0;

   if(precio != ''){
	resultado = precio * cantidad;
	g_form.setValue('monto_total_estimado', resultado);
   }
   
}]]></script>
